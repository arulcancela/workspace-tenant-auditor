# ============================================================================
# workspace-tenant-auditor — Plantilla de configuración
# ============================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas el archivo `.env` a Git (ya está en .gitignore).
# ============================================================================

# ----- Dominio principal a auditar -----------------------------------------
# Dominio primario del tenant de Google Workspace (sin http, sin @).
TENANT_DOMAIN=ejemplo.com

# ----- Autenticación (Service Account + Domain-Wide Delegation) -------------
# Ruta al fichero JSON de la Service Account descargado desde GCP.
# Se recomienda una ruta fuera del repo, p.ej. /etc/tenant-auditor/sa.json
GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/service-account.json

# Email del superadmin que la Service Account va a suplantar (impersonation).
# Debe ser un superadmin real del tenant para acceder a Directory y Reports.
DELEGATED_ADMIN_EMAIL=admin@ejemplo.com

# Scopes OAuth2 requeridos (lista separada por espacios).
# Principio de mínimo privilegio: solo lectura de directorio y auditoría.
GOOGLE_SCOPES=https://www.googleapis.com/auth/admin.directory.user.readonly https://www.googleapis.com/auth/admin.directory.group.readonly https://www.googleapis.com/auth/admin.directory.domain.readonly https://www.googleapis.com/auth/admin.reports.audit.readonly

# ----- Comportamiento de la auditoría --------------------------------------
# Directorio de salida por defecto para los informes.
OUTPUT_DIR=./reports

# Formato(s) de salida: html,pdf,json (separados por comas).
OUTPUT_FORMATS=html,pdf,json

# Máximo de trabajadores concurrentes al llamar a las APIs (rate-limit friendly).
MAX_WORKERS=4

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ----- Umbrales configurables de los checks --------------------------------
# Días sin login para considerar una cuenta "inactiva".
INACTIVE_DAYS_THRESHOLD=90

# Días sin cambio de contraseña para considerar una contraseña "obsoleta".
PASSWORD_MAX_AGE_DAYS=180

# ----- Modo demo ------------------------------------------------------------
# Si es true, se usan datos de ejemplo y no se llama a ninguna API real.
DRY_RUN=false
